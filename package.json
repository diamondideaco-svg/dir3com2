{
  "name": "dir3com-next",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "verify:project-identity": "node scripts/verify-project-identity.mjs",
    "seed:sandbox": "node scripts/sandbox/synthetic-dataset.mjs seed",
    "reset:sandbox": "node scripts/sandbox/synthetic-dataset.mjs reset",
    "purge:synthetic": "node scripts/sandbox/synthetic-dataset.mjs purge",
    "sandbox:target": "node scripts/sandbox/resolve-target-env.mjs",
    "sandbox:schema:apply": "node scripts/sandbox/apply-staging-schema.mjs",
    "sandbox:schema:rollback": "node scripts/sandbox/rollback-staging-schema.mjs",
    "sandbox:e2e": "node scripts/sandbox/dabra-sandbox-e2e.mjs",
    "sandbox:verify": "node scripts/sandbox/verify-synthetic-integrity.mjs",
    "sandbox:public-isolation": "node scripts/sandbox/check-public-isolation.mjs",
    "sandbox:migration-safety": "node scripts/sandbox/check-migration-safety.mjs",
    "eval:sandbox:generate": "node scripts/sandbox/generate-eval-suite.mjs",
    "eval:sandbox": "node scripts/sandbox/run-eval-suite.mjs",
    "test:sandbox": "node --import tsx --test tests/dabra-sandbox.test.ts",
    "test:schema-compat": "node --import tsx --test tests/schema-compatibility.integration.test.ts",
    "mobile:dev": "npm --workspace @dir3com/mobile run start",
    "mobile:typecheck": "npm --workspace @dir3com/mobile run typecheck"
  },
  "dependencies": {
    "@next/third-parties": "^16.2.12",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.111.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^12.23.12",
    "next": "16.2.11",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-icons": "^5.7.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^20",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "pg": "^8.23.0",
    "postcss": "^8",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.20.5",
    "typescript": "^5"
  }
}
