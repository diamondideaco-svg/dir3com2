{
  "name": "dir3com-next",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "seed:sandbox": "node scripts/sandbox/synthetic-dataset.mjs seed",
    "reset:sandbox": "node scripts/sandbox/synthetic-dataset.mjs reset",
    "purge:synthetic": "node scripts/sandbox/synthetic-dataset.mjs purge",
    "sandbox:target": "node scripts/sandbox/resolve-target-env.mjs",
    "sandbox:schema:apply": "node scripts/sandbox/apply-staging-schema.mjs",
    "sandbox:schema:rollback": "node scripts/sandbox/rollback-staging-schema.mjs",
    "sandbox:e2e": "node scripts/sandbox/dabra-sandbox-e2e.mjs",
    "sandbox:verify": "node scripts/sandbox/verify-synthetic-integrity.mjs",
    "sandbox:public-isolation": "node scripts/sandbox/check-public-isolation.mjs",
    "sandbox:migration-safety": "node scripts/sandbox/check-migration-safety.mjs",
    "sandbox:purge-owned": "node scripts/sandbox/purge-owned-synthetic.mjs",
    "sandbox:core-schema:verify": "node scripts/sandbox/verify-core-schema-readiness.mjs",
    "eval:sandbox:generate": "node scripts/sandbox/generate-eval-suite.mjs",
    "eval:sandbox": "node scripts/sandbox/run-eval-suite.mjs",
    "test:sandbox": "node --import tsx --test tests/dabra-sandbox.test.ts",
    "test:ai-global": "node --import tsx --test tests/ai-global.test.ts",
    "test:dabra-orchestration": "node --import tsx --test tests/dabra-agentic-orchestration.test.ts",
    "test:openai": "node --import tsx --test tests/openai-web.test.ts",
    "test:gemini": "node --import tsx --test tests/gemini-web.test.ts",
    "test:anthropic": "node --import tsx --test tests/ai-anthropic.test.ts",
    "test:deepseek": "node --import tsx --test tests/ai-deepseek.test.ts",
    "test:xai": "node --import tsx --test tests/ai-xai.test.ts",
    "test:qwen": "node --import tsx --test tests/ai-qwen.test.ts",
    "test:mistral": "node --import tsx --test tests/mistral-web.test.ts",
    "test:providers-matrix": "node --import tsx --test tests/providers-matrix.test.ts",
    "test:seven-provider-routing": "node --import tsx --test tests/seven-provider-routing.test.ts",
    "smoke:anthropic": "node --import tsx scripts/anthropic-live-smoke.ts",
    "smoke:deepseek": "node --import tsx scripts/deepseek-live-smoke.ts",
    "smoke:xai": "node --import tsx scripts/xai-live-smoke.ts",
    "smoke:qwen": "node --import tsx scripts/qwen-live-smoke.ts",
    "smoke:mistral": "node --import tsx scripts/mistral-live-smoke.ts",
    "smoke:providers-matrix": "node --import tsx scripts/provider-matrix-live.ts",
    "test:schema-compat": "node --import tsx --test tests/schema-compatibility.integration.test.ts",
    "test:liteapi": "node --import tsx --test tests/liteapi-provider.test.ts",
    "test:liteapi-hmac": "node --import tsx --test tests/liteapi-hmac-auth.test.ts",
    "smoke:liteapi": "node --import tsx scripts/liteapi-sandbox-smoke.ts",
    "test:all": "node --import tsx --test tests/*.test.ts",
    "mobile:dev": "npm --workspace @dir3com/mobile run start",
    "mobile:typecheck": "npm --workspace @dir3com/mobile run typecheck"
  },
  "dependencies": {
    "@next/third-parties": "^16.2.12",
    "@supabase/ssr": "0.7.0",
    "@supabase/supabase-js": "^2.111.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "12.23.12",
    "next": "16.2.11",
    "pg": "^8.16.3",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-icons": "^5.7.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^20",
    "@types/pg": "^8.15.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "postcss": "^8",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.20.5",
    "typescript": "^5"
  },
  "overrides": {
    "motion-dom": "12.23.12",
    "motion-utils": "12.23.6"
  }
}
